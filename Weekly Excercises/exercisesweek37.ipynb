    "X5_std[X5_std == 0] = 1  # safeguard to avoid division by zero for constant features\n",
    "X5_norm = (X5 - X5_mean) / X5_std\n",
    "\n",
    "H_OLS5 = 2 / n * X5_norm.T @ X5_norm\n",
    "eigval_OLS5 = np.linalg.eigvalsh(H_OLS5)\n",
    "lm_max_OLS5 = eigval_OLS5.max()\n",
