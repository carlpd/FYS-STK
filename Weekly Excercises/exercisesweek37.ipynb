    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "rng = np.random.default_rng(2026)\n",
    "n = 100\n",
    "x = rng.uniform(-2.0, 2.0, n)\n",
    "y = 2.0 - x + 5.0 * x**2 + 0.5 * rng.standard_normal(n)   # drop the noise term if you prefer"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f19f59b8",
