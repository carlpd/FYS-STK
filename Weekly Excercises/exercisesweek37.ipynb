    "y_centered = y - np.mean(y)\n",
    "\n",
    "H_part1 = 2 / n_samples * X_scaled.T @ X_scaled\n",
    "eigvals_part1 = np.linalg.eigvalsh(H_part1)\n",
    "kappa_part1 = eigvals_part1.max() / eigvals_part1.min()\n",
    "\n",
    "print(\"--- DEL 1 RESULTS ---\")\n",
    "print(f\"Kondisjonstall for syntetisk datasett: {kappa_part1:.4f}\")\n",
    "\n",
    "# Analytisk OLS og Ridge\n",
    "theta_ols_1 = np.linalg.solve(X_scaled.T @ X_scaled, X_scaled.T @ y_centered)\n",
    "lmb = 0.1\n",
    "theta_ridge_1 = np.linalg.solve(X_scaled.T @ X_scaled + lmb * np.eye(n_features), X_scaled.T @ y_centered)\n",
